# ---------------------------------------------------------------------
# SIGNING MATERIAL — the most important lines in this file.
#
# keystore/flacplayer-key.jks is THE key this app is signed with
# (SHA-256 743e01c0…). Android will refuse any future update signed with
# a different key, so if it is lost the published app can never be
# updated again — by anyone, ever. It must be backed up somewhere off
# this machine, and it must never reach a public repository.
#
# keystore.properties holds its passwords in plaintext.
# keystore.properties.example is the safe placeholder and IS tracked.
# ---------------------------------------------------------------------
keystore/*.jks
keystore/*.keystore
keystore/keystore.properties
!keystore/keystore.properties.example
*.jks
*.keystore

# Build outputs — ~12.5 MB, regenerated by any build
.gradle/
build/
app/build/
app/.cxx/
local.properties
.cxx/

# R8/ProGuard output
*.hprof

# IDE / tooling
.idea/
*.iml
.DS_Store

# Host test harness scratch (tools/tests/run.sh writes to $TMPDIR)
tools/tests/*.inc

# Assembled release artifacts (attach to a GitHub Release, do not commit)
release/
