# Copy this file to keystore.properties (same folder) and fill in the
# real values -- keystore.properties is gitignored and must never be
# committed. build.gradle.kts reads this file to sign the release APK.
#
# These are the values you used when you created flacplayer-key.jks:
#   alias: mi_alias
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=mi_alias
storeFile=flacplayer-key.jks
